buscar_por_distribuidora(Distribuidora) :-
    pelicula(Nombre, Estudio, Lanzamiento, _, _, _),
    sub_string(Estudio, _, _, _, Distribuidora),
    format('- -w (-w)-n', [Nombre, Lanzamiento]),
    fail.
